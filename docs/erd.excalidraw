    },
    {
      "id": "text-53b34e8ece",
      "type": "text",
      "x": 838.4000000000004,
      "y": 1588.5,
      "width": 520.7999999999996,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-d96c18d982"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 192118626,
      "version": 1,
      "versionNonce": 599281732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761091200000,
      "link": null,
      "locked": false,
      "text": "PK 기본 키 · FK 외래 키 · UK UNIQUE · PK,FK 부모 키가 PK의 일부\n\n\n\n\n선 끝 기호: ┤ 1  ·  까마귀발 여러 개 (숫자 라벨이 기준)\n회색 = v0.2용 (v0.1 코드는 쓰지 않는다)",
      "originalText": "PK 기본 키 · FK 외래 키 · UK UNIQUE · PK,FK 부모 키가 PK의 일부\n\n\n\n\n선 끝 기호: ┤ 1  ·  까마귀발 여러 개 (숫자 라벨이 기준)\n회색 = v0.2용 (v0.1 코드는 쓰지 않는다)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "line-cc0eba0ea8",
      "type": "line",
      "x": 838.4000000000004,
