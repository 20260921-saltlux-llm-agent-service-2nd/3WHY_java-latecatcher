      "locked": false
    },
    {
      "id": "text-151ad2d5f1",
      "type": "text",
      "x": 52,
      "y": 1542.0,
      "width": 585.0,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-f583239ef5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 570294932,
      "version": 1,
      "versionNonce": 583944751,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761091200000,
      "link": null,
      "locked": false,
      "text": "그 달 기록이 없는 훈련생 찾기 — LEFT JOIN + IS NULL",
      "originalText": "그 달 기록이 없는 훈련생 찾기 — LEFT JOIN + IS NULL",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-e70a227385",
      "type": "text",
      "x": 52,
      "y": 1588.5,
      "width": 674.4000000000004,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-f583239ef5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1672884256,
      "version": 1,
      "versionNonce": 389878645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761091200000,
      "link": null,
      "locked": false,
      "text": "SELECT m.member_id, m.name\nFROM member_tbl m\nLEFT JOIN attendance_tbl a\n       ON a.member_id = m.member_id\n      AND a.attend_date BETWEEN ? AND ?   -- 그 달 1일 ~ min(말일, 어제)\nWHERE a.attendance_id IS NULL;",
      "originalText": "SELECT m.member_id, m.name\nFROM member_tbl m\nLEFT JOIN attendance_tbl a\n       ON a.member_id = m.member_id\n      AND a.attend_date BETWEEN ? AND ?   -- 그 달 1일 ~ min(말일, 어제)\nWHERE a.attendance_id IS NULL;",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "text-c1453bf491",
      "type": "text",
      "x": 52,
      "y": 1720.5,
      "width": 615.2999999999997,
      "height": 52.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-f583239ef5"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 278218446,
      "version": 1,
      "versionNonce": 1760458282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761091200000,
      "link": null,
      "locked": false,
      "text": "① LEFT JOIN: 회원은 모두 남고, 짝 출결이 없으면 a.* = NULL\n② WHERE a.attendance_id IS NULL: 짝이 없는 회원만 → \"기록 없음\" 명단 (L-09)\n날짜 조건은 ON에 둔다. WHERE로 옮기면 NULL 행이 빠져 결과가 늘 빈다.",
      "originalText": "① LEFT JOIN: 회원은 모두 남고, 짝 출결이 없으면 a.* = NULL\n② WHERE a.attendance_id IS NULL: 짝이 없는 회원만 → \"기록 없음\" 명단 (L-09)\n날짜 조건은 ON에 둔다. WHERE로 옮기면 NULL 행이 빠져 결과가 늘 빈다.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
