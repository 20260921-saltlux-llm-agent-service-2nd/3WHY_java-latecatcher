    {
      "id": "text-aafd68373b",
      "type": "text",
      "x": 52,
      "y": 1130.5,
      "width": 671.9999999999997,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
