<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <comment>ClassDayRepository SQL</comment>

<!-- 수업일 -->
    <!-- L-05 #20에서 추가 (YY): 수업일이면 is_class_day가 1, 날짜가 없으면 결과 행이 없다 -->
    <entry key="selectIsClassDay">
        SELECT is_class_day FROM class_day_tbl WHERE class_date = ?
    </entry>
</properties>
