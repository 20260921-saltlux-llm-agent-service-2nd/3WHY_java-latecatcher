<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <comment>MemberRepository SQL</comment>

    <!-- TODO: 신규 회원 저장 SQL을 작성하세요. -->
    <entry key="insertMember">
        insert into member_tbl (
        name,
        age,
        phone
        ) values (
        ?,
        ?,
        ?
        )
    </entry>

    <!-- TODO: 휴대폰 번호로 회원을 조회하는 SQL을 작성하세요. -->
    <entry key="selectMemberByPhone">
        select
        member_id,
        name,
        age,
        phone
        from member_tbl
        where phone = ?
    </entry>

    <!-- TODO: member_id로 회원을 삭제하는 SQL을 작성하세요. -->
    <entry key="deleteMemberById">
        delete from member_tbl
        where member_id = ?
    </entry>
</properties>
